---
layout: "layouts/base.webc"

title: "Feed Reader"
description: "Ryan's RSS Feed Reader"
---

<filters-provider>
  <articles-provider>
    <side-bar id="sidebar" role="menu" popover>
      <aside>
        <nav>
          <feeds-list></feeds-list>
        </nav>
      </aside>
    </side-bar>
    <main>
      <header>
        <refresh-progress-bar></refresh-progress-bar>
        <nav>
          <button popovertarget="sidebar" id="sidebar-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24">
              <use href="/icons.svg#hamburger-menu"></use>
            </svg>
          </button>
          <header-title></header-title>
          <div id="header-actions">
            <refresh-button></refresh-button>
            <filter-modal></filter-modal>
          </div>
        </nav>
      </header>
      <div id="main-content">
        <feed-status></feed-status>
        <articles-list></articles-list>
      </div>
    </main>
  </articles-provider>
</filters-provider>
<style>
  body {
    background-color: var(--clr-bg);
    color: var(--clr-dark);

    display: flex;
    height: 100vh;
    margin: 0;
    overflow-x: clip;
    /** viewport-fit=cover (for the refresh button's bottom inset) lets the page run under the notch in landscape,
        so keep the content clear of it as it was before */
    padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
  }

  side-bar {
    border-right: 1px solid black;
    z-index: 1;
  }

  side-bar:not(:defined) {
    display: none;
  }

  side-bar aside {
    padding-block: 1rem 4rem;
    padding-inline: 1rem;
    overflow-y: auto;
  }

  #sidebar-button {
    border-radius: 8px;
    padding: 0.2rem;
    cursor: pointer;
    border: 1px solid currentColor;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.3);
  }

  #sidebar-button svg {
    display: block;
  }

  main {
    flex: 1;
    transition: transform 0.2s;
    /** Day headers in the article list stick this far from the top of the scroll container */
    --day-header-top: 0px;
  }

  main header {
    background-color: vaR(--clr-accent);
    color: white;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.5);
  }

  #header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  main header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.5rem 1rem;
  }

  #main-content {
    padding: 1rem;
  }

  @media screen and (min-width: 600px) {
    body {
      overflow-y: hidden;
    }

    main {
      overflow-y: auto;
      /** Set by stickyHeader.js */
      --day-header-top: var(--main-header-height, 0px);
    }

    /** <main> is the scroll container on desktop, so its header can stick to the top, and compacts once scrolled */
    main header {
      position: sticky;
      inset-block-start: 0;
      z-index: 2;
    }

    main header nav {
      transition: padding 0.2s;
    }

    main[data-scrolled] header nav {
      padding-block: 0.75rem;
    }

    main[data-scrolled] header-title {
      font-size: 0.75rem;
    }

    #sidebar-button {
      display: none;
    }

    main header nav {
      padding-block-start: 3rem;
      padding-inline-start: 1.5rem;
    }
  }
</style>
<script type="module" src="/js/entrypoint.js" webc:keep></script>
